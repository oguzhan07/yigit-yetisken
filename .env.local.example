# ============================================================
#  Bu dosyayı ".env.local" olarak kopyala ve değerleri doldur.
#  .env.local asla git'e gönderilmez (.gitignore'da).
# ============================================================

# --- Supabase (zorunlu) ---
# Supabase paneli > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca sunucu tarafı (admin/webhook). ASLA tarayıcıya sızdırma!
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- iyzico (P2c'de gerekli; şimdilik boş bırakılabilir) ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- Resend (e-posta; P2b/P2c'de gerekli) ---
RESEND_API_KEY=
RESEND_FROM="Yiğit Yetişken <onboarding@resend.dev>"
